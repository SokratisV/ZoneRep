# BigWigsMods packager config. The repo root *is* the addon, so the package is
# built from here and named "ZoneRep" (the folder players extract into AddOns).
package-as: ZoneRep

# No bundled libraries and no externals, so no separate "nolib" zip.
enable-nolib-creation: no

# Use the hand-written changelog instead of generating one from commits.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Repo-meta files that shouldn't ship inside the addon zip.
ignore:
  - .github
  - .gitattributes
  - .gitignore
  - .pkgmeta
  - logo.png
